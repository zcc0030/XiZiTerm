{
  "name": "@xiziterm/desktop",
  "productName": "XiZiTerm",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "zcc0030 <50785866+zcc0030@users.noreply.github.com>",
  "homepage": "https://github.com/zcc0030/XiZiTerm",
  "description": "XiZiTerm - Self-hosted Cross-platform SSH Terminal & SFTP Manager (Tauri v2)",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "dist": "tauri build",
    "dist:win": "node scripts/package-win-zip.mjs",
    "dist:mac": "tauri build --bundles dmg,app",
    "dist:linux": "tauri build --bundles deb,appimage",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xiziterm/shared": "0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "zustand": "^5.0.2"
  }
}
