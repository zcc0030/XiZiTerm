{
  "name": "xiziterm",
  "version": "0.1.0",
  "private": true,
  "description": "XiZiTerm - Self-hosted Zero-Knowledge E2EE Cross-platform SSH Terminal & SFTP Manager",
  "license": "MIT",
  "author": "zcc0030 <50785866+zcc0030@users.noreply.github.com>",
  "homepage": "https://github.com/zcc0030/XiZiTerm",
  "repository": {
    "type": "git",
    "url": "https://github.com/zcc0030/XiZiTerm.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@xiziterm/desktop",
    "dev:server": "npm run dev --workspace=@xiziterm/server",
    "build": "npm run build --workspace=@xiziterm/desktop",
    "build:server": "npm run build --workspace=@xiziterm/server",
    "dist": "npm run dist --workspace=@xiziterm/desktop",
    "dist:win": "npm run dist:win --workspace=@xiziterm/desktop",
    "dist:mac": "npm run dist:mac --workspace=@xiziterm/desktop",
    "dist:linux": "npm run dist:linux --workspace=@xiziterm/desktop",
    "typecheck": "npm run typecheck --workspace=@xiziterm/shared && npm run typecheck --workspace=@xiziterm/desktop && npm run typecheck --workspace=@xiziterm/server"
  }
}
